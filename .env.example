# Backend (no trailing slash)
VITE_API_BASE_URL=https://opssynk-backend2-0.onrender.com
# Organization shown in the dashboard
VITE_ORGANIZATION_ID=org_demo

# firebase (production) | dev (local only: sends "Bearer dev:<uid>"; the deployed backend refuses it)
VITE_AUTH_MODE=firebase

# From Firebase console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=devops-6f096.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=devops-6f096
VITE_FIREBASE_APP_ID=
